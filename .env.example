# Hosted Postgres for ops/migrations. The Next.js app does not read this; it uses Supabase.
DATABASE_URL=
# Local preview origin. Production canonical is https://www.iguazu.dev
# (used automatically when VERCEL_ENV=production if this is unset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public Supabase credentials. Leave absent for an honest, read-only launch preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional Pollar onboarding on /login and /join. Use a pub_testnet_ key locally.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
# Server-only. Used for form rate limits, partnership inquiries, and outbox delivery.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM=IGUA.DEV <comunidad@iguazu.dev>
# Generate with openssl rand -hex 32. Required for /api/jobs/email (Vercel Cron).
CRON_SECRET=
# Persistent, shared rate limit bucket hashing secret (32+ characters).
RATE_LIMIT_SECRET=
# Optional Search Console / Bing HTML verification tokens (not required for the sitemap).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
