# Canonical origin; configure to the final HTTPS domain before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public Supabase credentials. Leave absent for an honest, read-only launch preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used exclusively for outbox delivery, never general member queries.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM=IGUA.DEV <comunidad@your-verified-domain.example>
# Generate with openssl rand -hex 32. Required for /api/jobs/email (Vercel Cron).
CRON_SECRET=
# Persistent, shared rate limit bucket hashing secret (32+ characters).
RATE_LIMIT_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
